{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(docker compose * php artisan *)",
            "Bash(docker compose * vendor/bin/pint *)",
            "Bash(docker compose * vendor/bin/phpstan *)",
            "Bash(docker compose run --rm laravel13-phpunit)",
            "Bash(docker compose run * npm run build)",
            "Bash(docker compose up -d laravel13)",
            "Bash(docker compose * composer *)",
            "Bash(openspec *)",
            "mcp__laravel-boost"
        ],
        "deny": [
            "Bash(git push *)"
        ]
    },
    "enabledMcpjsonServers": [
        "laravel-boost"
    ]
}
