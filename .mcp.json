{
    "mcpServers": {
        "laravel-boost": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "projects/demo13/docker-compose.yml",
                "exec",
                "-T",
                "-e",
                "XDEBUG_MODE=off",
                "laravel13",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@0.0.83",
                "--browser",
                "chromium",
                "--headless",
                "--isolated",
                "--output-dir",
                "/tmp/playwright-mcp"
            ]
        }
    }
}
