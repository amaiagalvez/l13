{
  "$schema": "https://opencode.ai/config.json",
  // Core skill loaded by default; others loaded on demand via skill tool.
  "skills": [
    ".github/skills/project-rules"
  ],
  "mcp": {
    "servers": {
      "laravel-boost": {
        "type": "local",
        "command": [
          "/usr/bin/docker",
          "compose",
          "-f",
          "projects/demo13/docker-compose.yml",
          "run",
          "--rm",
          "-e",
          "XDEBUG_MODE=off",
          "--entrypoint",
          "php",
          "laravel13",
          "artisan",
          "boost:mcp"
        ]
      }
    }
  },
  // Espejo de .vscode/settings.json (chat.tools.terminal.autoApprove).
  // Gana el último match; sin match, ask. Wildcards son texto (no regex).
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "docker compose * php artisan*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose * vendor/bin/pint*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose * vendor/bin/phpstan*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose run --rm laravel13-phpunit",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose run * npm run build",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose up -d laravel13",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose * composer*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    }
  ],
  // Agente para la revisión nocturna desatendida (testing13/nightlyReview.sh).
  // Solo escribe el informe: los deny se aplican siempre, también con `opencode run --auto`.
  "agents": {
    "nightly-review": {
      "mode": "primary",
      "description": "Ejecuta la skill full-review completa sin intervención y guarda el informe en .github/reviews/YYYY-MM-DD/.",
      "permissions": [
        {
          "action": "edit",
          "resource": ".github/reviews/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "deny"
        }
      ]
    }
  },
  // Pint es el único formateador de PHP; un formateador externo pelea con él y con los
  // @phpstan-ignore de las vistas. Se deja apagado a propósito.
  "formatter": false,
  // Ruido de eventos y de contexto (mismo origen que search.exclude de .vscode/settings.json).
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dc-data/**",
      "public/build/**",
      "storage/framework/**",
      "storage/logs/**"
    ]
  }
}