{
	"folders": [
		{
			"path": "../l13"
		}
	],
	"settings": {
		"files.readonlyInclude": {
			"**/.claude/agents/**": true,
			"**/.claude/skills/**": true,
			"**/.opencode/agents/**": true,
			"**/.opencode/skills/**": true
		},
		"files.exclude": {
			"**/projects/packages": true
		},
		"search.exclude": {
			".git/, vendor/, projects/packages/, storage/, tests/coverage/, node_modules/, .phpunit.result.cache, composer.lock": true,
			"**/projects/packages": true,
			"**/vendor": true,
			"**/storage": true,
			"**/coverage": true,
			"**/dc-data": true,
			"**/.git": true
		},
		"git.autoRepositoryDetection": true,
		"git.scanRepositories": [
			"testing13",
			"projects/demo13",
			"packages/basics13",
			"packages/entities13",
			"packages/entity-projects13",
			"packages/projects13",
		],
		"Laravel.phpEnvironment": "docker",
		"Laravel.phpCommand": [
			"docker",
			"compose",
			"-f",
			"projects/demo13/docker-compose.yml",
			"exec",
			"-T",
			"laravel13",
			"php"
		],
		"LaravelExtraIntellisense.phpCommand": "docker compose -f projects/demo13/docker-compose.yml exec -T -e XDEBUG_MODE=off laravel13 php -r \"{code}\"",
		"LaravelExtraIntellisense.basePathForCode": "/app-docker",
		"chat.tools.terminal.autoApprove": {
			"/pint --dirty --format agent$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/php artisan test( |$)/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/php artisan make:/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/npm run build$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^docker compose up -d laravel13$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/composer (ci:check|test|lint:check|types:check)$/": {
				"approve": true,
				"matchCommandLine": true
			}
		}
	}
}