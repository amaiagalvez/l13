{
	"folders": [
		{
			"path": "../l13"
		},
		{
			"path": "packages"
		}
	],
	"settings": {
		"todo-tree.ripgrep.ripgrep": "/snap/code/current/usr/share/code/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/linux-x64/rg",
		"Laravel.phpEnvironment": "docker",
		"Laravel.phpCommand": [
			"docker",
			"compose",
			"-f",
			"demo13/docker-compose.yml",
			"exec",
			"-T",
			"laravel13",
			"php"
		],
		"LaravelExtraIntellisense.phpCommand": "docker compose -f demo13/docker-compose.yml exec -T -e XDEBUG_MODE=off laravel13 php -r \"{code}\"",
		"LaravelExtraIntellisense.basePathForCode": "/app-docker",
		"chat.tools.terminal.autoApprove": {
			"/pint --dirty --format agent$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/php artisan test( |$)/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/php artisan make:/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/npm run build$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^docker compose up -d laravel13$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/composer (ci:check|test|lint:check|types:check)$/": {
				"approve": true,
				"matchCommandLine": true
			}
		}
	}
}